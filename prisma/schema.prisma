// Koneksi langsung ke Postgres Supabase (bukan SQLite / file lokal).
// DATABASE_URL: Dashboard → Settings → Database → Connection string (URI), port 5432.
// Bila memakai pooler 6543 + `prisma migrate`, tambahkan `directUrl` di datasource (lihat README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AlumniMaster {
  id        BigInt   @id @default(autoincrement())
  nama      String
  nomorId   String   @map("nomor_id") @default("")
  konsulat  String   @default("")
  sudahIsi  Boolean  @map("sudah_isi") @default(false)
  createdAt DateTime @map("created_at") @db.Timestamptz(6) @default(now())

  responses AlumniResponse[]

  @@map("alumni_master")
}

model AlumniResponse {
  id                 BigInt   @id @default(autoincrement())
  alumniId           BigInt   @map("alumni_id")
  kesibukan          String?
  sosialMedia        String?  @map("sosial_media")
  whatsapp           String?
  instagram          String?
  tiktok             String?
  twitter            String?
  linkedin           String?
  sosialLainnya      String?  @map("sosial_lainnya")
  domisili           String?
  ikutReuni          String?  @map("ikut_reuni")
  ideAlumni          String?  @map("ide_alumni")
  merchandiseVote    String?  @map("merchandise_vote")
  merchandiseIdeLain String? @map("merchandise_ide_lain")
  createdAt          DateTime @map("created_at") @db.Timestamptz(6) @default(now())

  alumni AlumniMaster @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId])
  @@map("alumni_responses")
}
